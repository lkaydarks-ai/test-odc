# ==============================================================================
# Variables d'environnement pour l'API Backend NestJS (Config Server)
# Copier ce fichier sous le nom .env pour vos configurations locales spécifiques.
# ATTENTION : Ne jamais committer de vrais mots de passe ou clés dans .env !
# ==============================================================================

# Port d'écoute du serveur HTTP (défaut : 3000)
PORT=3000

# URL de connexion à la base de données MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/config-server

# Environnement d'exécution (development, production, test)
NODE_ENV=development
