# ==============================================================================
# .gitignore — Monorepo ODC Campus (test-odc)
# Exclusions globales pour Node.js/NestJS, React, Flutter, Python, macOS & Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RÈGLES CRITIQUES D'INCLUSION (NE JAMAIS IGNORER)
# ------------------------------------------------------------------------------
!.agents/
!.agents/**
!.github/
!.github/**
!.claude/
!.claude/**
!GEMINI.md
!CLAUDE.md
!.env.example

# ------------------------------------------------------------------------------
# 2. SYSTÈME D'EXPLOITATION (macOS & Windows)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# 3. ENVIRONNEMENT, SECRETS & CLÉS
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.cert
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 4. LOGS ET FICHIERS TEMPORAIRES
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.tmp/
.temp/
*.swp
*.swo
*~
.history/

# ------------------------------------------------------------------------------
# 5. NODE.JS & NESTJS (Backend config-server & Frontend)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
.npm/
.yarn/
.pnpm-store/
config-server/backend/uploads/*
!config-server/backend/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 6. REACT & NEXT.JS (odc_backoffice, frontend)
# ------------------------------------------------------------------------------
.next/
out/
.cache/
.eslintcache
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# 7. FLUTTER & DART (odc_super_app)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
ephemeral/
*.lock
!pubspec.lock
!package-lock.json

# Cibles de compilation Android & iOS générées par Flutter
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/.last_build_id
**/android/.gradle/
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# ------------------------------------------------------------------------------
# 8. PYTHON (Services backend & scripts éventuels)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 9. COUVERTURE & TESTS
# ------------------------------------------------------------------------------
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 10. FICHIERS D'ÉDITEURS (IDE)
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

